PORT=3001

# Casdoor OAuth (côté serveur — ne jamais exposer le secret au frontend)
CASDOOR_URL=https://casdoor.yotech.mg
CASDOOR_CLIENT_ID=your_client_id
CASDOOR_CLIENT_SECRET=your_client_secret
CASDOOR_REDIRECT_URI=http://localhost:5173/casdoor/callback
CASDOOR_ORGANIZATION=yotech
CASDOOR_APP_NAME=yotech
CASDOOR_ASSOCIATE_ROLE=associe

# OpenRouter — suggestion des comptes comptables (JSON)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://yotech.mg
OPENROUTER_APP_NAME=YoTech ERP
ACCOUNTING_AI=true
